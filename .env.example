# Two env files, both gitignored:
#
#   .env         compose-level passwords ONLY (docker compose reads it).
#   .env.server  the domain API's config (server/db.js loads it explicitly).
#
# Generate passwords with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# --- .env ---------------------------------------------------------------------
POSTGRES_SUPER_PASSWORD=change-me
KARMA_API_PASSWORD=change-me
NOCODB_ADMIN_PASSWORD=change-me

# --- .env.server --------------------------------------------------------------
# connection string the API and migrations use (karma_api role, karma db)
DATABASE_URL=postgres://karma_api:change-me@127.0.0.1:5432/karma

# WorkOS AuthKit — REQUIRED: the hosted login is the only way to sign in.
# The redirect URI must be allowlisted in the WorkOS dashboard (Redirects page).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8080/api/auth/callback
SESSION_SECRET=

# Emails on this domain are auto-enrolled as MEMBERS on first sign-in
# (admins are promoted by hand). Defaults to karmastaff.com; "" turns it off.
#AUTO_INVITE_DOMAIN=karmastaff.com

# --- Python pipeline (phase 6, its own environment) ---------------------------
#KARMA_API_URL=http://localhost:8080
#KARMA_API_TOKEN=
