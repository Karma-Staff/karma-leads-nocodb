# --- secrets -----------------------------------------------------------------
# Never commit these. apify_token has a .example.json beside it; the env files
# are described in .env.example.
apify_token.json
.env
.env.server

# --- live data ---------------------------------------------------------------
# Everything stateful lives in data/, never loose in the repo root:
#   data/noco.db             the frozen pre-migration SQLite backup the ETL
#                            (scripts/etl-from-noco.js) can rebuild Postgres from
#   data/lead_registry.db    maps every lead to its permanent Lead Code — the
#                            ONE thing here that cannot be regenerated; keep a
#                            copy somewhere that is not this machine
#   data/backups/            sync.py snapshots the registry here before writing
data/
*.db
*.db-shm
*.db-wal
*.db.bak-*

# generated by scripts/etl-from-noco.js — a migration receipt, not source
scripts/etl-report.txt

# blocklist.json is the do-not-call list: real phone numbers.
dashboard/blocklist.json

# --- raw lead exports --------------------------------------------------------
# The CSV/XLSX sources are real names, phones and emails. They live outside this
# repo (see DATA in dashboard/setup_and_import.py) and stay out of git even if a
# copy ever lands here.
old leads/
master_leads/
New_job_search/
dnc/
*.csv
*.xlsx
*.xls

# --- build / tooling ---------------------------------------------------------
node_modules/
__pycache__/
*.pyc
npm-debug.log*
.DS_Store
Thumbs.db

# Claude Code session worktrees — never part of the app
.claude/
