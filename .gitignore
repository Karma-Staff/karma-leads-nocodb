# --- secrets -----------------------------------------------------------------
# Never commit these. Each has a .example.json beside it showing the shape.
api_token.json
apify_token.json
admin_credentials.json
.env

# --- live data ---------------------------------------------------------------
# noco.db is the running database: statuses, owners, notes, comments, favourites
# and every member's invitation. It is also ~12 MB and rewritten constantly.
noco.db
noco.db-shm
noco.db-wal
*.db

# lead_registry.db maps every lead to its permanent Lead Code. It is the ONE
# thing here that cannot be regenerated: noco.db can be rebuilt from the source
# files, but the codes — and the statuses, owners and notes hanging off them —
# only exist in the registry. Keep a backup somewhere that is not this folder.
# setup_v2.py and sync.py snapshot it to lead_registry.db.bak-* before writing.
lead_registry.db*
*.db.bak-*

# recents.json is the per-account activity trail behind the Recent tab — real
# staff emails and the leads they looked at.
recents.json

# blocklist.json is the do-not-call list: real phone numbers.
dashboard/blocklist.json

# --- raw lead exports --------------------------------------------------------
# The CSV/XLSX sources are real names, phones and emails. They live outside this
# repo (see DATA in dashboard/setup_and_import.py) and stay out of git even if a
# copy ever lands here.
old leads/
master_leads/
New_job_search/
dnc/
*.csv
*.xlsx
*.xls

# --- build / tooling ---------------------------------------------------------
node_modules/
__pycache__/
*.pyc
npm-debug.log*
.DS_Store
Thumbs.db
