# --- secrets -----------------------------------------------------------------
# Never commit these. apify_token has a .example.json beside it; the env files
# are described in .env.example.
apify_token.json
.env
.env.server

# --- live data ---------------------------------------------------------------
# noco.db is the frozen pre-migration SQLite database, kept as the backup the
# ETL (scripts/etl-from-noco.js) can rebuild Postgres from.
noco.db
noco.db-shm
noco.db-wal
*.db

# lead_registry.db maps every lead to its permanent Lead Code. It is the ONE
# thing here that cannot be regenerated: noco.db can be rebuilt from the source
# files, but the codes — and the statuses, owners and notes hanging off them —
# only exist in the registry. Keep a backup somewhere that is not this folder.
# sync.py snapshots it into backups/ (registry.py backup()) before writing.
lead_registry.db*
*.db.bak-*
backups/

# generated by scripts/etl-from-noco.js — a migration receipt, not source
scripts/etl-report.txt

# blocklist.json is the do-not-call list: real phone numbers.
dashboard/blocklist.json

# --- raw lead exports --------------------------------------------------------
# The CSV/XLSX sources are real names, phones and emails. They live outside this
# repo (see DATA in dashboard/setup_and_import.py) and stay out of git even if a
# copy ever lands here.
old leads/
master_leads/
New_job_search/
dnc/
*.csv
*.xlsx
*.xls

# --- build / tooling ---------------------------------------------------------
node_modules/
__pycache__/
*.pyc
npm-debug.log*
.DS_Store
Thumbs.db
